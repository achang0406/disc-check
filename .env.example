# Copy to .env.local for local development.
# Local dev and Vercel Preview → staging project (iunqmpxp…).
# Vercel Production → prod hub (mczxxonw…).
#
# Cloud Agent tip: .env.local is generated automatically by
# .cursor/scripts/bootstrap-supabase.sh. Choose the backend with SUPABASE_TARGET
# (default: local) or switch on demand with:
#   .cursor/scripts/use-supabase-target.sh <local|staging|prod>
# Remote targets resolve keys in this order:
#   1. A local dotenv file if present (gitignored, VM-only):
#        staging -> .env.stage.local     prod -> .env.prod.local
#   2. Cloud Agent Secrets (URLs default to the refs above):
#        STAGING_SUPABASE_ANON_KEY (required), STAGING_SUPABASE_SERVICE_ROLE_KEY (optional)
#        PROD_SUPABASE_ANON_KEY    (required), PROD_SUPABASE_SERVICE_ROLE_KEY    (optional)
#        STAGING_SUPABASE_URL / PROD_SUPABASE_URL (optional overrides)
# If .env.vercel.local exists (from `vercel env pull`), its VERCEL_* vars
# (e.g. VERCEL_OIDC_TOKEN) are merged into the generated .env.local for every
# target, without overriding the Supabase config above.

# Supabase project URL (Settings → API)
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key (Settings → API)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Postgres schema for PostgREST
VITE_SUPABASE_DB_SCHEMA=pickup_frisbee

# Seed script only — never expose in the browser (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional alias for seed script
SUPABASE_URL=https://your-project.supabase.co

# Web Push (generate with: npx web-push generate-vapid-keys)
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Set to true when testing push via ngrok (registers the service worker in dev)
VITE_ENABLE_SW=false

# Supabase Edge Function secrets (Dashboard → Edge Functions → Secrets)
# Set on pickup-frisbee-notify-push and pickup-frisbee-process-push-outbox:
# VAPID_PUBLIC_KEY=same-as-VITE_VAPID_PUBLIC_KEY
# VAPID_PRIVATE_KEY=your-vapid-private-key
# VAPID_SUBJECT=mailto:you@example.com
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.
#
# pg_cron calls pickup-frisbee-process-push-outbox every 2 min (migration 034).
# Requires pg_cron + pg_net extensions and vault secret service_role_key.
